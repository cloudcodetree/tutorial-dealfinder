# DealFinder DEV image — for docker-compose only.
#
# Editable install (`pip install -e .`) so `uvicorn --reload` picks up live edits
# to the source that docker-compose mounts over /app at runtime. The PRODUCTION
# image is the sibling `Dockerfile` (baked, no reload, test_deploy guards its CMD);
# this one deliberately trades that immutability for a fast edit→reload loop.
FROM python:3.11-slim

WORKDIR /app

# Build-time install of the project + its dependencies. At runtime the compose
# service bind-mounts ./ over /app, so the installed deps (in site-packages) and
# the editable finder stay, while the package source under /app/dealfinder is live.
#
# LIGHT by default (keeps the image small and the Colima disk from ballooning).
# The heavy ML extras (torch/mlflow/prefect) are NOT installed here; they power
# /models (torch), /tracking (mlflow), and /pipeline-on-Prefect. Run those via
# the opt-in "full" compose profile (docker-compose.full.yml → Dockerfile.full),
# or in the host venv. Everything else — search, RAG, /context, /evals, the
# inspectors, the SPA — serves fine from this light image.
COPY . .
RUN pip install --no-cache-dir -e ".[dev]"

EXPOSE 8000

# Overridden by compose for the `seed` one-shot; this is the default (the API).
CMD ["uvicorn", "dealfinder.serve:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]

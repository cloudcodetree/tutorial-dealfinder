# DealFinder SPA DEV image — Vite dev server with HMR, for docker-compose only.
#
# docker-compose bind-mounts ./frontend over /app for live editing, and keeps
# THIS image's /app/node_modules behind a named volume, so the Linux deps
# installed here win over the host's (macOS) node_modules — no native-binary
# clashes, no `npm install` on the host required.
FROM node:20-slim

WORKDIR /app

# Install deps first for a cached layer; package-lock.json makes `npm ci` reproducible.
COPY package.json package-lock.json ./
RUN npm ci

COPY . .

EXPOSE 5173

# Vite reads VITE_API_PROXY_TARGET (set by compose to http://backend:8000) and
# proxies /search, /me, /healthz to the backend service — same-origin, no CORS.
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "5173"]

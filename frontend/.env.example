# DealFinder frontend config (Part 27). Copy to `.env.local` and fill in.
# These are Vite build-time vars — anything prefixed VITE_ is exposed to the
# browser bundle, so only PUBLIC values belong here (the Supabase anon key is
# public by design; never put a service-role key or JWT secret in this file).

# FastAPI backend base URL. Leave blank in dev to use the Vite proxy (which
# forwards /search, /search/stream and /me to http://localhost:8000). In
# production set it to your deployed API origin, e.g. https://api.dealfinder.app
VITE_API_BASE=

# Supabase project (Project Settings → API). Needed for sign-in and /me.
# Without these, the app runs anonymously and public search still works.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# DealFinder front end config. The app needs no keys: it calls the same-origin
# /api, and sign-in settings come from the backend's /config.json at runtime.
#
# VITE_API_PROXY_TARGET: where `npm run dev` sends /api (with /api stripped).
# vite.config.ts reads it from your shell, not from this file, e.g.
#   VITE_API_PROXY_TARGET=http://127.0.0.1:8000 npm run dev
# Unset, it is http://localhost:8000.
VITE_API_PROXY_TARGET=

# Live data-source credentials for DealFinder (copy to .env, fill in, never commit .env).
# Apify (managed scraping) — free token at https://console.apify.com/account/integrations
APIFY_TOKEN=
APIFY_ACTOR=automation-lab~google-shopping-scraper
# RapidAPI Real-Time Product Search — subscribe (free) then key from https://rapidapi.com
RAPIDAPI_KEY=
# Postgres (e.g. Supabase) — full connection string
DATABASE_URL=
# Which live sources /search uses, comma-separated (unset = every course source).
# Production runs Best Buy only. eBay is never listed here: it feeds only the eBay box.
DEALFINDER_SOURCES=
# "live" (verdicts on Best Buy rows, the default) or "check" (only Check a deal rates).
# Any other value turns verdicts off.
DEALFINDER_VERDICT_MODE=live
# Seconds each live source gets before it is skipped and benched.
DEALFINDER_SOURCE_TIMEOUT_S=8
# Set to 1 to show eBay sandbox (fake) listings in the eBay box while developing.
DEALFINDER_EBAY_ALLOW_SANDBOX=
